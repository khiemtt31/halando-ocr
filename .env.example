APP_NAME=doc-ocr-api
APP_ENV=local
SECRET_KEY=change-me-now
AUTH_PROVIDER=keycloak

DATABASE_URL=sqlite+aiosqlite:////app/data/dococr.db
LOCAL_STORAGE_ROOT=/app/data/storage

DEMO_DEFAULT_ROLES=documents:read,documents:write,documents:delete,jobs:read,jobs:run,admin:manage
DEMO_DEFAULT_SUB=demo-user
DEMO_DEFAULT_EMAIL=demo@example.com
DEMO_DEFAULT_NAME=Demo User

KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_PUBLIC_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=halando
KEYCLOAK_CLIENT_ID=halando-api
KEYCLOAK_AUDIENCE=halando-api
KEYCLOAK_SCOPES=openid profile email

SEEDED_ACCOUNT_ENABLED=true
SEEDED_ACCOUNT_SUB=00000000-0000-4000-8000-000000000001
SEEDED_ACCOUNT_USERNAME=demo
SEEDED_ACCOUNT_PASSWORD=demo123!
SEEDED_ACCOUNT_EMAIL=demo@halando.local
SEEDED_ACCOUNT_NAME=Demo User

MAX_UPLOAD_SIZE_MB=25
UPLOAD_URL_TTL_SECONDS=900
DOWNLOAD_URL_TTL_SECONDS=900

OCR_DEFAULT_LANGUAGE=eng
OCR_TIMEOUT_SECONDS=300
OCR_MAX_PAGES=50
WORKER_POLL_INTERVAL_SECONDS=2
AUTO_CREATE_SCHEMA=true
